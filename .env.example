# Env for Gym SaaS web (never commit real secrets)

# Gym Backend API (prod default matches docs/api/client-auth.md)
NEXT_PUBLIC_API_BASE_URL=https://gym-backend-lovat-mu.vercel.app

# Google OAuth: web callback is {origin}/auth/google/callback
# Backend must allow this origin via GOOGLE_OAUTH_REDIRECT_ORIGINS and
# Supabase Auth → Redirect URLs must include the same callback URL.

# Context7 — use local Cursor / shell env, not this file for real keys
CONTEXT7_API_KEY=
